# MedRisk Audit Lab
# Copy this file to .env only when Live LLM Mode is needed:
#   cp .env.example .env
#
# Never commit .env or real credentials.

LLM_PROVIDER=none
ALLOW_LIVE_LLM=false
STORE_LLM_INPUTS=false
STORE_LLM_OUTPUTS=false

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional application settings
APP_ENV=development
LOG_LEVEL=INFO
